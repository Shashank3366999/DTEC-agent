# Robot settings. Copy to config.env. No API key is needed on the robot.

# Where the built AimDK is. On 24 Nov the organisers found it at /agibot/software/common (no container).
AIMDK_PATH=/agibot/software/common

# Live screen web app (route display, organiser alerts), e.g. https://dtec-agent.onrender.com
WEBAPP_URL=
# Same secret word as the web app's TOOL_SECRET (leave empty if the web app has none)
TOOL_SECRET=

# 1 = listen to the raw microphone: no wake word, needed so the operator can just say "done".
#     The raw mic has no echo cancellation, so the mic is muted while the robot speaks (half duplex).
# 0 = the robot's processed mic: echo-cancelled, but silent until the wake word, every time.
RAW_MIC=1
HALF_DUPLEX=1
# With RAW_MIC=0 only: auto = first mic stream that speaks, or the exact id from the "mic stream heard" log line.
MIC_STREAM=auto
# Speaker volume for ./run_robot.sh takeover (72 is the robot's normal; 95 worked in the loud hall)
VOLUME=95
# Noise gate: higher = ignores more background chatter (try 600 in a loud room, 200 if quiet voices are missed)
NOISE_MIN_RMS=350
# 0 = switch the noise gate off
NOISE_GATE=1
# Camera markers (printed from the web app page /markers). 0 = off
MARKERS=1
# Smallest marker side in pixels that counts as "the robot is here" (higher = must be closer)
MARKER_MIN_PX=70
# 1 = print every ElevenLabs event
VERBOSE=0
