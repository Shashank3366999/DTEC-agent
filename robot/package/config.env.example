# Robot settings. Copy to config.env and fill in. No API key is needed on the robot.

# AimDK folder on PC2 (ask the MangoBot engineer), e.g. /opt/aimdk
AIMDK_PATH=

# Reception screen web app (check-in, route QR, operator alerts), e.g. https://dtec-agent.onrender.com
WEBAPP_URL=
# Same secret word as the web app's TOOL_SECRET (leave empty if the web app has none)
TOOL_SECRET=

# 1 = mute the mic while the robot speaks (use if the robot interrupts itself)
HALF_DUPLEX=0
# 0 = first mic that speaks, 1 = built-in mic, 2 = external mic
MIC_STREAM=0
# Noise gate: higher = ignores more background chatter (try 600 in a loud room, 200 if quiet voices are missed)
NOISE_MIN_RMS=350
# 0 = switch the noise gate off
NOISE_GATE=1
# 1 = print every ElevenLabs event
VERBOSE=0
